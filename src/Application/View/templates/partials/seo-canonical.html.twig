{#- Canonical and crawl tags, as semitexa.com's seo-head does. The host is fixed:
    the same pages answer on local and preview hosts, and only one address may
    be canonical. The query string is dropped so tracking parameters never
    become the canonical. -#}
{% set canonicalUrl = 'https://framework.semitexa.com' ~ (current_url()|split('?')|first) %}
<link rel="canonical" href="{{ canonicalUrl }}">
<meta property="og:url" content="{{ canonicalUrl }}">
<meta name="robots" content="index,follow,max-image-preview:large">
{#- Share card rendered by semitexa/site tools/render-og-cards.php. -#}
<meta property="og:image" content="https://framework.semitexa.com/assets/semitexa-demo/img/og/default.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Semitexa Framework: live PHP demos with the source next to the result">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://framework.semitexa.com/assets/semitexa-demo/img/og/default.png">
