{#
 # Shared wrapper for the demo's tenancy feature pages.
 #
 # Sits between each `platform/tenancy-*.html.twig` page and the shared
 # ShowcaseKit feature layout, so the 5 tenancy pages only have to capture their
 # bespoke L1/L2/L3 markup into `previewHtml` / `l2Content` / `l3Content` (and
 # set them BEFORE extending this wrapper). This wrapper maps the feature
 # resource data onto the kit feature contract, applies the demo chrome, and —
 # to keep the rendered content byte-for-byte equivalent to the retired
 # `demo-feature.html.twig` (which rendered only the three blocks) — suppresses
 # the projector-supplied highlights / documentBodyHtml / explanation / source so
 # only the captured blocks appear.
 #
 # Inheritance chain:
 #   platform/tenancy-*.html.twig
 #     → platform/_tenancy-feature.html.twig   (this file)
 #       → @project-layouts-ShowcaseKit/layouts/feature.html.twig
 #         → @project-layouts-ShowcaseKit/layouts/showcase.html.twig
 #}
{% extends '@project-layouts-ShowcaseKit/layouts/feature.html.twig' %}

{# --- map the demo feature resource → kit feature-page contract --- #}
{# `title` / `summary` are supplied by the concrete tenancy page (the old
   feature_title / feature_summary block text) so the heading copy is preserved
   verbatim. We only fall back to resource data if a page omits them. #}
{% set title = title|default(featureTitle|default('Feature')) %}
{% set summary = summary|default(entryLine|default(null)) %}
{% set backHref = '/demo/' ~ (section|default('platform')) %}

{# Keep content identical to the old demo-feature output: only the three blocks. #}
{% set highlights = [] %}
{% set documentBodyHtml = null %}
{% set explanation = null %}
{% set sourceCode = [] %}
{% set relatedFeatures = [] %}

{# sidebar tree: the demo `featureTree` is already the kit `layers` shape. #}
{% set layers = featureTree|default(navSections|default([])) %}
{% set currentSection = section %}
{% set currentSlug = slug %}

{# --- demo identity / chrome --- #}
{% set sk_site_title = 'Semitexa Demo' %}

{% block head %}
  {{ parent() }}
{% endblock %}

{% block sk_brand %}
  <a class="sk-brand" href="/">
    <span class="sk-brand__text"><span class="semitexa-logo" aria-label="Semitexa">Semite<span>xa</span></span></span>
  </a>
{% endblock %}

{% block sk_topnav %}
  {% include '@project-layouts-semitexa-demo/partials/header-nav.html.twig' %}
{% endblock %}

{% block sk_sidebar %}
  {% include '@project-layouts-semitexa-demo/partials/header-mobile-nav.html.twig' %}
  {{ parent() }}
{% endblock %}

{% block sk_footer %}{% include '@project-layouts-semitexa-demo/partials/footer.html.twig' %}{% endblock %}
