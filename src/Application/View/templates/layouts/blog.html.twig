{% extends '@project-layouts-semitexa-demo/pages/home.html.twig' %}

{% block body_attrs %} class="demo-page-bg demo-blog-page" data-theme-label-dark="Dark mode" data-theme-label-light="Light mode"{% endblock %}
{% set canonicalUrl = current_absolute_url()|split("/")|slice(0, 3)|join("/") ~ (article.path|default("/blog")) %}

{% block head %}
  {{ parent() }}
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:site_name" content="Semitexa Blog">
  <meta property="og:locale" content="en_US">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <meta name="twitter:card" content="summary">
  {% block blog_metadata %}{% endblock %}
{% endblock %}

{% block sk_sidebar %}
  {% include '@project-layouts-semitexa-demo/partials/header-mobile-nav.html.twig' %}
  <nav class="blog-sidebar" aria-label="Blog navigation">
    <a class="blog-sidebar__home" href="/blog">← All articles</a>
    {% block blog_contents %}
      <p class="blog-eyebrow">Explore Semitexa</p>
      <a href="/demo/get-started/installation">Getting started</a>
      <a href="/demo/events/sse">Live SSE demo</a>
      <a href="/demo/rendering">Server-rendered interfaces</a>
    {% endblock %}
  </nav>
{% endblock %}

{% block showcase_main %}
  <div class="blog-wrap">{% block blog_main %}{% endblock %}</div>
{% endblock %}
