{{ asset_require('semitexa-demo:js:component-event-bridge-demo') }}

<div class="preview-card component-bridge-preview">
  <p class="preview-card__eyebrow">One component model</p>
  <h3 class="preview-card__title">One click, the component's own server method, one backend event bus.</h3>
  <p class="preview-card__summary">The button opens the disclosure locally. The same click reaches the component's <code>#[UiOn]</code> method through HUG, which answers by dispatching a domain event to the application's listeners.</p>

  <div class="component-bridge-preview__surface">
    <div class="component-bridge-preview__action">
      {{ component('demo-disclosure-prompt', {
        label: 'Dispatch backend event →',
        variant: 'learnMore',
        target: 'component-bridge-details',
      }) }}
    </div>

    <div id="component-bridge-details" class="expandable-section component-bridge-preview__details" data-expanded="false" data-expandable>
      <div class="expandable-section__inner">
        <div class="preview-callout">
          <p class="preview-card__summary">Local disclosure works immediately. The server hears the same click and acknowledges it below.</p>
        </div>
      </div>
    </div>

    <div class="preview-stats">
      <div class="preview-stats__item">
        <span class="preview-stats__value"><code>DemoDisclosureExpanded</code></span>
        <span class="preview-stats__label">Domain event the handler dispatches</span>
      </div>
      <div class="preview-stats__item">
        <span class="preview-stats__value"><code>#[UiOn(part: 'trigger', event: 'click')]</code></span>
        <span class="preview-stats__label">The handler, on the component</span>
      </div>
      <div class="preview-stats__item">
        <span class="preview-stats__value"><code>POST /__semitexa_hug</code></span>
        <span class="preview-stats__label">HUG, the one inbound door</span>
      </div>
    </div>

    <div class="component-bridge-preview__console" data-component-bridge-console>
      <p class="component-bridge-preview__console-label">Backend acknowledgment</p>
      <pre class="component-bridge-preview__console-body">Waiting for the first dispatch…</pre>
    </div>
  </div>
</div>
