{#
 # Framework demo — FEATURE detail (L1/L2/L3).
 #
 # Structural migration: delegates the progressive-reveal feature layout to the
 # shared ShowcaseKit feature template and maps the demo's feature resource data
 # onto the kit contract. Palette is 100% skin-driven (terracotta via the
 # `semitexa-demo` skin resolved for framework.semitexa.test).
 #
 # The LIVE PREVIEW, source code, related links, and L2/L3 companion content are
 # preserved verbatim by rendering the demo's own preview/companion templates and
 # components into the kit's raw-HTML slots (previewHtml / l2Content / l3Content)
 # using the set-capture-before-extends pattern. Every data-* hook, reactive /
 # deferred slot, and JS module reference therefore travels through unchanged.
 #
 # Demo resource vars (from DemoFeatureResource / DemoFeaturePageProjector):
 #   section, slug, featureTitle, summary, entryLine, highlights, sectionLabel,
 #   documentBodyHtml, explanation, relatedPayloads, learnMoreLabel,
 #   deepDiveLabel, sourceCode, resultPreview(Template|Data),
 #   l2Content(Template|Data), l3Content(Template|Data),
 #   + shell context: featureTree, navSections, currentSection, currentSlug,
 #     navMode, activeLayerKey, authUi, infoWhat/How/Why/Keywords.
 #}

{# --- L1 live preview rendered into the kit previewHtml (raw HTML).
       Preserves the demo's reactive / deferred slot markup and data-* hooks. --- #}
{% if resultPreviewTemplate is defined and resultPreviewTemplate %}
  {% set previewHtml %}
    {% include resultPreviewTemplate with resultPreviewData|default({}) only %}
  {% endset %}
{% elseif resultPreview is defined and resultPreview %}
  {% set previewHtml = resultPreview %}
{% endif %}

{# Capture the demo's raw L2/L3 content (from withL2Content/withL3Content) before
   we reuse those names as the kit contract vars. #}
{% set _demoL2ContentRaw = l2Content is defined ? l2Content : null %}
{% set _demoL3ContentRaw = l3Content is defined ? l3Content : null %}
{% set _hasSourceCode = sourceCode is defined and sourceCode|length > 0 %}
{% set _hasL2Companion = (l2ContentTemplate is defined and l2ContentTemplate) or _demoL2ContentRaw %}
{% set _hasL3Companion = (l3ContentTemplate is defined and l3ContentTemplate) or _demoL3ContentRaw %}

{# --- L2 extra content: render the demo source-code component (tabs, copy,
       PHP highlighting) + any companion L2 content into the kit l2Content slot.
       `sourceCode` is intentionally NOT forwarded to the kit so the kit's plain
       <pre> renderer does not duplicate the rich demo code block. Only set the
       slot when there is real content, so the kit's L2 gating stays accurate. --- #}
{% if _hasSourceCode or _hasL2Companion %}
  {% set l2Content %}
    {% if _hasSourceCode %}
      {{ component('demo-code-block', {
        tabs: sourceCode,
        featureSlug: slug,
      }) }}
    {% endif %}
    {% if l2ContentTemplate is defined and l2ContentTemplate %}
      <div class="feature-detail__l2-extra">
        {% include l2ContentTemplate with l2ContentData|default({}) only %}
      </div>
    {% elseif _demoL2ContentRaw %}
      <div class="feature-detail__l2-extra">{{ _demoL2ContentRaw|raw }}</div>
    {% endif %}
  {% endset %}
{% else %}
  {% set l2Content = null %}
{% endif %}

{# --- L3 extra content: render any companion L3 content into the kit l3Content
       slot (rendered alongside the kit's explanation how/why/keywords). --- #}
{% if _hasL3Companion %}
  {% set l3Content %}
    {% if l3ContentTemplate is defined and l3ContentTemplate %}
      <div class="feature-detail__l3-extra">
        {% include l3ContentTemplate with l3ContentData|default({}) only %}
      </div>
    {% elseif _demoL3ContentRaw %}
      <div class="feature-detail__l3-extra">{{ _demoL3ContentRaw|raw }}</div>
    {% endif %}
  {% endset %}
{% else %}
  {% set l3Content = null %}
{% endif %}

{# --- Rich highlight chips: pair each plain-string highlight with a hover
       definition when a matching keyword exists, so the kit renders it as a
       tooltip chip. Demo keywords come from explanation.keywords / infoKeywords
       as { term, definition }. Highlights with no match stay plain strings. --- #}
{% set _demoKeywords = (explanation.keywords is defined and explanation.keywords)
  ? explanation.keywords
  : (infoKeywords|default([])) %}
{% if highlights is defined and highlights|length > 0 and _demoKeywords|length > 0 %}
  {% set _richHighlights = [] %}
  {% for highlight in highlights %}
    {% set _definition = null %}
    {% for kw in _demoKeywords %}
      {% if _definition is null and kw.term is defined and kw.term|lower == highlight|lower %}
        {% set _definition = kw.definition|default(null) %}
      {% endif %}
    {% endfor %}
    {% set _richHighlights = _richHighlights|merge([
      _definition ? { label: highlight, definition: _definition } : highlight
    ]) %}
  {% endfor %}
  {% set highlights = _richHighlights %}
{% endif %}

{% extends '@project-layouts-ShowcaseKit/layouts/feature.html.twig' %}

{# --- map the demo feature resource → kit feature-page contract --- #}
{% set title = featureTitle|default('Feature') %}
{% set summary = entryLine|default(summary|default(null)) %}
{% set backHref = '/demo/' ~ section %}
{% set relatedFeatures = relatedPayloads|default([]) %}

{# --- Title icon: glyph before the H1, resolved by the demo Twig function. --- #}
{% block feature_title_prefix %}{{ demo_title_icon(featureTitle|default(title|default('Feature')), section|default(null), slug|default(null)) }}{% endblock %}

{# --- Inline L1 context panel: the demo what/how/why orientation block. --- #}
{% block feature_l1_context %}
  {% if (infoWhat is defined and infoWhat) or (infoHow is defined and infoHow) or (infoWhy is defined and infoWhy) or (infoKeywords is defined and infoKeywords|length > 0) %}
    {% include '@project-layouts-semitexa-demo/partials/feature-info.html.twig' with {
      what: infoWhat|default(null),
      how: infoHow|default(null),
      why: infoWhy|default(null),
      keywords: infoKeywords|default([]),
    } only %}
  {% endif %}
{% endblock %}

{# --- Donate support callout below the feature article. --- #}
{% block feature_aside %}
  {% include '@project-layouts-semitexa-demo/partials/donate-block.html.twig' only %}
{% endblock %}

{# sidebar tree: the demo `featureTree` is already the kit `layers` shape
   (start-here feature-links + full-catalog section-groups). #}
{% set layers = featureTree|default(navSections|default([])) %}
{% set currentSection = section %}
{% set currentSlug = slug %}

{# --- demo identity / chrome --- #}
{% set sk_site_title = 'Semitexa Demo' %}
{% set sk_body_class = 'demo-page-bg' %}

{% block head %}
  {{ parent() }}
{% endblock %}

{# Deliberately empty — no parent().

   The kit's version of this block loads its own disclosure.js and code-block.js.
   The demo already ships both behaviours through its asset pipeline: its own
   disclosure.js, which additionally drives the demo-disclosure-prompt component,
   the disclosure:expand event and the explanation tooltips, and code-tabs.js for
   the demo's own code block. Loading the kit's copies on top meant two click
   handlers on every [data-disclosure-trigger]: one opened the section, the other
   closed it in the same tick, so "Try it yourself" did nothing at all. #}
{% block sk_body_scripts %}{% endblock %}

{% block sk_brand %}
  <a class="sk-brand" href="/">
    <span class="sk-brand__text"><span class="semitexa-logo" aria-label="Semitexa">Semite<span>xa</span></span></span>
  </a>
{% endblock %}

{% block sk_topnav %}
  {% include '@project-layouts-semitexa-demo/partials/header-nav.html.twig' %}
{% endblock %}

{% block sk_sidebar %}
  {% include '@project-layouts-semitexa-demo/partials/header-mobile-nav.html.twig' %}
  {{ parent() }}
{% endblock %}

{% block sk_footer %}{% include '@project-layouts-semitexa-demo/partials/footer.html.twig' %}{% endblock %}
