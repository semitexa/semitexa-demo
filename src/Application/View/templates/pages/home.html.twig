{#
 # Framework demo — HOME.
 #
 # Structural migration: extends the shared ShowcaseKit home page so the layout,
 # sidebar tree, chrome, and skin-mode toggle come from the kit. Palette is 100%
 # skin-driven (terracotta via the `semitexa-demo` skin).
 #
 # The demo's navigation layers (Start Here / Core Concepts / Full Catalog) map
 # to the kit feature-tree `layers` shape: `featureTree` (the sidebar tree) is
 # already that shape, so it drives the kit sidebar directly. `navigationLayers`
 # (all three layers, with feature-links and nested sections) plus the rich
 # `sections` catalog drive the home body.
 #
 # The demo home body is bespoke CONTENT the kit home contract does not model
 # (hero sidecar/ledger/terminal, navigation-layer section grids, donate button,
 # high-signal demos prompt), so `showcase_main` is overridden to reproduce the
 # demo home faithfully on the kit shell, reusing the demo's own feature-card
 # component for the layer/section grids. Sidebar + chrome + scripts come from
 # the kit unchanged.
 #
 # Demo resource vars: navigationLayers, sections, starterSections,
 #   featuredFeatures, totalFeatureCount, + shell context (featureTree,
 #   navSections, navMode, activeLayerKey, authUi).
 #}
{% extends '@project-layouts-ShowcaseKit/pages/home.html.twig' %}

{# sidebar tree: the demo `featureTree` is already the kit `layers` shape. #}
{% set layers = featureTree|default(navSections|default([])) %}

{# --- demo identity / chrome --- #}
{% set sk_site_title = 'Semitexa Demo — Framework Showcase' %}
{# Restore the ambient page background (radial glows + grid) lost in the kit migration. #}
{% set sk_body_class = 'demo-page-bg' %}

{% block head %}
  {{ parent() }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block sk_brand %}
  <a class="sk-brand" href="/">
    <span class="sk-brand__text"><span class="semitexa-logo" aria-label="Semitexa">Semite<span>xa</span></span></span>
  </a>
{% endblock %}

{% block sk_topnav %}
  {% set navAuth = authUi|default({}) %}
  {% set navAuthIsAuthenticated = navAuth.isAuthenticated|default(false) %}
  {% set navAuthHref = navAuthIsAuthenticated
    ? navAuth.accountUrl|default('/demo/auth/google')
    : navAuth.startUrl|default('/demo/auth/google/start') %}
  {% set navAuthTitle = navAuthIsAuthenticated
    ? (navAuth.email|default(navAuth.label|default('Signed in with Google')))
    : navAuth.signInTitle|default('Sign in with Google to unlock advanced demos') %}
  {% set navAuthText = navAuthIsAuthenticated
    ? 'Hi, ' ~ navAuth.shortLabel|default(navAuth.label|default('there'))
    : navAuth.actionLabel|default('Sign in') %}
  <a class="sk-topnav__signin{{ navAuthIsAuthenticated ? ' sk-topnav__signin--active' : '' }}" href="{{ navAuthHref }}" title="{{ navAuthTitle }}">{{ navAuthText }}</a>
  <a href="https://github.com/semitexa" target="_blank" rel="noopener" aria-label="Semitexa on GitHub" title="GitHub">GitHub</a>
  <a href="https://www.linkedin.com/company/semitexa/" target="_blank" rel="noopener" aria-label="Semitexa on LinkedIn" title="LinkedIn">LinkedIn</a>
  <a href="https://www.facebook.com/semitexa" target="_blank" rel="noopener" aria-label="Semitexa on Facebook" title="Facebook">Facebook</a>
{% endblock %}

{% block sk_footer %}<p class="sk-footer__copy">© 2026 Semitexa</p>{% endblock %}

{# --- demo home body, reproduced faithfully on the kit shell --- #}
{% block showcase_main %}
  {% set readyFeatures = featuredFeatures|default([]) %}
  {% if readyFeatures is empty %}
    {% set readyFeatures = [] %}
    {% for section in sections|default([]) %}
      {% for feature in section.features|default([]) %}
        {% if readyFeatures|length < 3 %}
          {% set readyFeatures = readyFeatures|merge([feature]) %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endif %}

  {% set sectionCount = sections|default([])|length %}
  {% set navigationLayers = navigationLayers|default([]) %}

  <section class="demo-hero">
    <div class="demo-hero__content">
      <p class="demo-hero__brand">SEMITEXA FRAMEWORK</p>
      <h1 class="demo-hero__tagline">See the framework behaving like a product, not like a brochure.</h1>
      <p class="demo-hero__lede">Routes, DI, ORM, SSR, tenancy, and async flows presented as one connected system with working entry points.</p>
      <div class="demo-hero__ctas">
        <a href="#layers" class="demo-hero__cta demo-hero__cta--primary">Explore Layers</a>
        <a href="https://github.com/semitexa" class="demo-hero__cta demo-hero__cta--secondary" target="_blank" rel="noopener">View Source</a>
        <a href="/demo/get-started/installation" class="demo-hero__cta demo-hero__cta--secondary">Start Here</a>
      </div>
      <div class="demo-hero__badges">
        <span class="demo-hero__badge">PHP 8.4 Attributes</span>
        <span class="demo-hero__badge">Swoole-native</span>
        <span class="demo-hero__badge">Zero Config</span>
      </div>
    </div>

    <div class="demo-hero__sidecar">
      <div class="demo-hero__signal">
        <p class="demo-hero__signal-label">Live Demo Surface</p>
        <div class="demo-hero__signal-value">{{ totalFeatureCount|default(0) }}</div>
        <p class="demo-hero__signal-text">feature routes currently wired under <code>/demo</code></p>
      </div>

      <div class="demo-hero__ledger">
        <div class="demo-hero__ledger-item">
          <span class="demo-hero__ledger-value">{{ sectionCount }}</span>
          <span class="demo-hero__ledger-label">sections</span>
        </div>
        <div class="demo-hero__ledger-item">
          <span class="demo-hero__ledger-value">{{ navigationLayers|length }}</span>
          <span class="demo-hero__ledger-label">nav layers</span>
        </div>
        <div class="demo-hero__ledger-item">
          <span class="demo-hero__ledger-value">{{ readyFeatures|length }}</span>
          <span class="demo-hero__ledger-label">high-signal demos</span>
        </div>
      </div>

      <div class="demo-hero__links">
        {% include '@project-layouts-semitexa-demo/partials/donate-button.html.twig' with {
          class: 'demo-donate-btn',
          label: 'Support Semitexa',
          title: 'Support Semitexa development with PayPal',
        } only %}
      </div>

      <div class="demo-hero__terminal">
        <p class="demo-hero__terminal-title">System framing</p>
        <ul class="demo-hero__terminal-lines">
          <li><span>$</span> browse working feature flows</li>
          <li><span>$</span> inspect source beside runtime output</li>
          <li><span>$</span> move from docs to behavior in one shell</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="layers" class="demo-layers">
    {% for layer in navigationLayers %}
      <div id="{{ layer.key }}" class="demo-layer demo-layer--{{ layer.key }}">
        <div class="demo-block-heading demo-block-heading--tight">
          <p class="demo-block-heading__eyebrow">{{ layer.eyebrow }}</p>
          <h2 class="demo-layer__heading">{{ layer.label }}</h2>
          <p class="demo-block-heading__text">{{ layer.summary }}</p>
        </div>

        {% if layer.type == 'feature-links' %}
          <div class="demo-layer__feature-list">
            {% for feature in layer.features|default([]) %}
              <a href="{{ feature.href }}" class="demo-layer__feature-link" {% if feature.opensInNewTab|default(false) %}target="_blank" rel="noopener"{% endif %}>
                <span class="demo-layer__feature-title">{{ feature.title }}</span>
                <span class="demo-layer__feature-summary">{{ feature.summary }}</span>
              </a>
            {% endfor %}
          </div>
        {% else %}
          <div class="demo-layer__section-grid">
            {% for section in layer.sections|default([]) %}
              {% include '@project-layouts-semitexa-demo/components/feature-card.html.twig' with {
                href: section.href,
                key: section.key,
                label: section.label,
                summary: section.summary,
                icon: section.icon,
                eyebrow: section.eyebrow,
                featureCount: section.featureCount,
                prerequisites: section.prerequisites,
                starter: layer.key == 'core-concepts',
              } only %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </section>

  <section class="demo-ready-prompt demo-ready-prompt--featured" data-ready-prompt>
    <h2 class="demo-ready-prompt__heading">High-signal demos</h2>
    <p class="demo-ready-prompt__text">These walkthroughs show Semitexa at its most convincing: deferred delivery, reactive work, and tenant-aware runtime behavior.</p>
    <div class="demo-ready-prompt__suggestions">
      {% for feature in readyFeatures %}
        <a href="{{ feature.href }}" class="demo-ready-prompt__link" {% if feature.opensInNewTab|default(false) %}target="_blank" rel="noopener"{% endif %}>{{ feature.title }}{% if feature.opensInNewTab|default(false) %}<span class="demo-link-external-indicator" aria-hidden="true">↗</span>{% endif %}</a>
      {% endfor %}
    </div>
  </section>
{% endblock %}
