{% extends '@project-layouts-semitexa-demo/layouts/blog.html.twig' %}

{% block blog_metadata %}
  <meta property="article:published_time" content="{{ article.published }}T00:00:00+00:00">
  <meta property="article:section" content="{{ article.category }}">
  <meta name="author" content="{{ article.author }}">
  <meta name="twitter:title" content="{{ article.title }}">
  <meta name="twitter:description" content="{{ article.description }}">
  {% set articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: article.title,
    description: article.description,
    datePublished: article.published ~ 'T00:00:00+00:00',
    inLanguage: 'en',
    articleSection: article.category,
    author: {'@type': 'Person', name: article.author, url: article.authorUrl},
    publisher: {'@type': 'Organization', name: 'Semitexa', url: 'https://github.com/semitexa'},
    mainEntityOfPage: {'@type': 'WebPage', '@id': canonicalUrl},
    url: canonicalUrl
  } %}
  <script type="application/ld+json"{{ csp_nonce_attr() }}>{{ articleSchema|json_encode(15)|raw }}</script>
{% endblock %}

{% block blog_contents %}
  <p class="blog-eyebrow">Inside the runtime</p>
  <a href="#built-for-this">Designed for this from day one</a>
  <a href="#two-lifetimes">Two lifetimes to understand</a>
  <a href="#runtime-lab">Try the running example</a>
  <a href="#container-lifetimes">A container that knows lifetimes</a>
  <a href="#coroutine-isolation">Concurrency with context</a>
  <a href="#connection-pools">Connections with an owner</a>
  <a href="#live-delivery">A runtime for live HTML</a>
